<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView android:id="@+id/img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />
    <!-- tap zones: heights and the top margin are set in px by HudWidget.bind, one per line, anchored to the top -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <FrameLayout android:id="@+id/zone_l1" android:layout_width="match_parent" android:layout_height="0dp" />
        <FrameLayout android:id="@+id/zone_l2" android:layout_width="match_parent" android:layout_height="0dp" />
        <FrameLayout android:id="@+id/zone_l3" android:layout_width="match_parent" android:layout_height="0dp" />
        <FrameLayout android:id="@+id/zone_l4" android:layout_width="match_parent" android:layout_height="0dp" />
        <FrameLayout android:id="@+id/zone_l5" android:layout_width="match_parent" android:layout_height="0dp" />
    </LinearLayout>
</FrameLayout>
