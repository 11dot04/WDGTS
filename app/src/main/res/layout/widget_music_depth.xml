<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg">
    <ImageView android:id="@+id/img"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" />
    <FrameLayout android:id="@+id/zone_main"
        android:layout_width="match_parent" android:layout_height="match_parent" />
    <!-- control row zones (live only while the controls are shown) -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="76" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="24" android:orientation="horizontal">
            <FrameLayout android:id="@+id/zone_prev" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="30" />
            <FrameLayout android:id="@+id/zone_play" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="40" />
            <FrameLayout android:id="@+id/zone_next" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="30" />
        </LinearLayout>
    </LinearLayout>
    <!-- top-right toggle (dots / pill) -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="15" android:orientation="horizontal">
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="76" />
            <FrameLayout android:id="@+id/zone_toggle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="24" />
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="85" />
    </LinearLayout>
</FrameLayout>
