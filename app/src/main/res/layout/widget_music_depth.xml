<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg">
    <ImageView android:id="@+id/img"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" />
    <FrameLayout android:id="@+id/zone_main"
        android:layout_width="match_parent" android:layout_height="match_parent" />
    <!-- button row, always live: previous | next (left half), play / pause (right half).
         Fractions match MusicDepthWidget: row top 78.5%, height 16.5%, side margin 6.5%, gap 3%. -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="78.5" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="16.5" android:orientation="horizontal">
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="6.5" />
            <FrameLayout android:id="@+id/zone_prev" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="21" />
            <FrameLayout android:id="@+id/zone_next" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="21" />
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="3" />
            <FrameLayout android:id="@+id/zone_play" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="42" />
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="6.5" />
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="5" />
    </LinearLayout>
</FrameLayout>
